# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 깃에 올라가지 않는다)
# Vercel 에 배포할 때는 같은 키를 프로젝트 Environment Variables 에 넣는다.

# ── Supabase (Settings > API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://giaqwbakjbgahvygcehx.supabase.co

# anon / Publishable key — 브라우저에 노출되는 것이 정상 (RLS로 막혀 있다)
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에_anon_또는_publishable_키

# service_role / Secret key — RLS를 무시하는 마스터 키.
# 절대 NEXT_PUBLIC_ 을 붙이지 말 것. 서버 라우트에서만 쓴다.
SUPABASE_SERVICE_ROLE_KEY=여기에_service_role_또는_secret_키

# ── 선택 ────────────────────────────────────────────────────
# 루트(/)로 들어온 사람을 회사 홈페이지로 보낸다. 비우면 안내 화면만 뜬다.
# NEXT_PUBLIC_SITE_URL=https://kuventing.scpadlab.com

# 매장·PIN·캠페인은 전부 DB에서 온다.
# 예전에 쓰던 NEXT_PUBLIC_CAMPAIGN_ID / OWNER_PIN / ADMIN_SECRET 은 더 이상 사용하지 않는다.
# 운영자 화면(/admin)은 Supabase Auth 이메일+비밀번호로 들어간다.
# 계정 생성: npm run admin -- 이메일주소
